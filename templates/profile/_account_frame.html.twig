{% set page_title = page_title|default('Личный кабинет') %}
{% set page_subtitle = page_subtitle|default('') %}
{% set show_verification_badge = show_verification_badge|default(false) %}

<section class="bg-[#f3f6fb] py-6 sm:py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-[#d9e5ff] bg-gradient-to-br from-[#0b5fff] to-[#0753dc] px-5 py-6 text-white shadow-[0_20px_60px_-30px_rgba(11,95,255,.8)] sm:px-8 sm:py-8">
            <nav class="mb-4 text-[11px] font-medium text-white/80" aria-label="Навигация">
                <a href="{{ path('app_homepage') }}" class="hover:text-white">Главная</a>
                <span class="mx-2">/</span>
                <span class="text-white">Личный кабинет</span>
            </nav>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-white/80">Клиентский портал</p>
                    <h1 class="mt-1 text-2xl font-bold leading-tight sm:text-3xl">{{ page_title }}</h1>
                    {% if page_subtitle %}
                        <p class="mt-2 max-w-2xl text-sm text-white/90">{{ page_subtitle }}</p>
                    {% endif %}
                </div>
                {% if show_verification_badge and user is defined %}
                    <span class="inline-flex h-fit rounded-full bg-white/15 px-3 py-1.5 text-xs font-semibold {{ user.isVerified ? 'text-emerald-100' : 'text-amber-100' }}">
                        {{ user.isVerified ? 'Email подтверждён' : 'Email не подтверждён' }}
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="mt-6">
            {% include 'components/_account_flashes.html.twig' with { keys: ['success', 'error'] } only %}
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-[250px_minmax(0,1fr)] lg:gap-8">
            <aside>
                {% include 'profile/_tabs.html.twig' %}
            </aside>
            <div class="min-w-0">
                {% block account_main %}{% endblock %}
            </div>
        </div>
    </div>
</section>
